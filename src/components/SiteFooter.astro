---
import { businessNavigation, contentNavigation } from '../data/business-navigation';
import { site, withBase } from '../lib/site';
import Icon from './Icon.astro';
interface Props { printContentOnly?: boolean; }
const { printContentOnly = false } = Astro.props;
---
<footer class:list={['mx-auto mt-10 max-w-4xl px-4 pb-8 pt-10', printContentOnly && 'print:hidden']}>
  <div class="grid gap-10 border-t border-border pt-8 md:grid-cols-[10rem_minmax(0,1fr)]">
    <section><a href={withBase('/')} class="text-xl font-bold">Frida</a><p class="mt-3 text-xs leading-6 text-muted-foreground">记录技术实践、项目与日常思考。</p><nav aria-label="关于与联系" class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-xs md:flex-col"><a href={withBase('/about/')} class="hover:text-primary">关于</a><a href={withBase('/contact/')} class="hover:text-primary">联系</a><a href={withBase('/portfolio/')} class="hover:text-primary">Portfolio</a><a href={withBase('/index.xml')} class="hover:text-primary">RSS 订阅</a></nav><div class="mt-4 flex gap-3 text-muted-foreground"><a href={site.github} aria-label="GitHub" class="hover:text-primary"><Icon name="github" /></a><a href={site.email} aria-label="邮箱" class="hover:text-primary"><Icon name="email" /></a></div></section>
    <div class="grid grid-cols-2 gap-x-6 gap-y-7 sm:grid-cols-3">
      <nav aria-label="内容索引"><h2 class="mb-3 text-sm font-semibold">内容</h2><ul class="space-y-1.5 text-xs leading-6 text-muted-foreground">{contentNavigation.map(item => <li><a href={withBase(item.path)} class="hover:text-primary">{item.title}</a></li>)}</ul></nav>
      {businessNavigation.map(root => <nav aria-label={`${root.title}目录`} class="min-w-0"><h2 class="mb-3 text-sm font-semibold"><a href={withBase(root.path)} class="hover:text-primary">{root.title}</a></h2><ul class="space-y-1.5 text-xs leading-6 text-muted-foreground">{root.children.map(group => <li><a href={withBase(group.path)} class="hover:text-primary">{group.title}</a></li>)}</ul></nav>)}
    </div>
  </div>
  <div class="mt-8 flex flex-wrap justify-between gap-2 border-t border-border/60 pt-4 text-xs leading-6 text-muted-foreground/70"><p>© {new Date().getFullYear()} {site.title}</p><p>Powered by <a href="https://astro.build" class="hover:text-primary">Astro</a></p></div>
</footer>
