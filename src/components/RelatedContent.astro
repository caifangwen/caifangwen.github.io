---
import { type Entry } from '../lib/content';
import { withBase, formatDate } from '../lib/site';
interface Props { entries: Entry[]; }
const { entries } = Astro.props;
---
<ul class="divide-y divide-border">{entries.map(entry => <li><a href={withBase(entry.url)} class="group block py-4 hover:bg-muted/40"><div class="flex flex-wrap gap-x-3 gap-y-1"><span class="min-w-0 flex-1 font-medium break-words group-hover:text-primary">{entry.title}</span><time class="text-xs leading-6 text-muted-foreground" datetime={entry.date.toISOString()}>{formatDate(entry.date)}</time></div>{entry.description && <p class="mt-1 line-clamp-2 text-sm leading-6 text-muted-foreground">{entry.description}</p>}</a></li>)}</ul>
