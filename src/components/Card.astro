---
import { type Entry } from '../lib/content';
import { withBase, termUrl, formatLongDate as formatDate } from '../lib/site';
import Icon from './Icon.astro';
import Cover from './Cover.astro';
import ProjectCard from './ProjectCard.astro';
interface Props { entry: Entry; compact?: boolean; home?: boolean; }
const { entry, compact = false, home = false } = Astro.props;
---
<article class:list={['group min-w-0', home && 'home-card']}>
  <div class="relative block">
    {entry.section === 'projects' ? <ProjectCard title={entry.title} description={entry.description} href={withBase(entry.url)} entry={entry} />
    : entry.section === 'shares' ? <div class="relative rounded-xl border border-border bg-card p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/20 hover:bg-primary/5 hover:shadow-md"><a href={withBase(entry.url)} aria-label={entry.title} class="absolute inset-0 z-10 rounded-xl focus-visible:outline-2 focus-visible:outline-primary"></a><div class="flex items-start justify-between gap-3"><h3 class="flex-1 text-base leading-snug font-semibold group-hover:text-primary">{entry.title}</h3>{entry.linkSource && <span class="flex shrink-0 items-center gap-1 text-xs text-muted-foreground"><Icon name="external-link" size={12} />{entry.linkSource}</span>}</div><p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted-foreground">{entry.description}</p><div class="mt-3 flex flex-wrap items-center gap-3 text-xs text-muted-foreground"><time datetime={entry.date.toISOString()}>{formatDate(entry.date)}</time><span class="flex gap-1.5">{entry.tags.slice(0, 3).map(tag => <a href={termUrl('tags', tag)} class="relative z-20 rounded-full bg-muted/50 px-2 py-0.5 hover:text-primary">{tag}</a>)}</span></div></div>
    : entry.section === 'discussions' || compact ? <div class="relative rounded-xl border border-border bg-card p-6 transition-all duration-300 hover:-translate-y-1 hover:border-primary/20 hover:bg-primary/5 hover:shadow-lg"><a href={withBase(entry.url)} aria-label={entry.title} class="absolute inset-0 z-10 rounded-xl focus-visible:outline-2 focus-visible:outline-primary"></a><h3 class="text-lg leading-tight font-semibold group-hover:text-primary">{entry.title}</h3>{entry.description && <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{entry.description}</p>}</div>
    : <div class="relative flex flex-col overflow-hidden rounded-xl border border-border bg-card transition-all duration-300 hover:-translate-y-1 hover:scale-[1.02] hover:border-primary/20 hover:bg-primary/5 hover:shadow-lg"><a href={withBase(entry.url)} aria-label={entry.title} class="absolute inset-0 z-10 rounded-xl focus-visible:outline-2 focus-visible:outline-primary"></a>
      <div class="block md:hidden"><div class="aspect-[2/1] overflow-hidden"><Cover entry={entry} /></div></div>
      <div class="absolute top-0 right-0 hidden h-full w-80 transition-opacity duration-300 group-hover:opacity-90 md:block"><Cover entry={entry} /></div>
      <div class="pointer-events-none relative z-20 flex flex-1 flex-col p-6 md:pr-84">
        <h3 class="mb-4 text-lg leading-tight font-semibold text-foreground group-hover:text-primary">{entry.title}</h3>
        {entry.description && <p class="mb-4 text-sm leading-relaxed text-muted-foreground">{entry.description}</p>}
        <div class="mt-auto text-sm text-muted-foreground"><div class="flex items-center gap-3"><div class="flex items-center gap-1.5"><Icon name="calendar" /><time datetime={entry.date.toISOString()} class="font-medium">{formatDate(entry.date)}</time></div><div class="flex items-center gap-1.5"><Icon name="clock" /><span class="font-medium">{entry.minutes} 分钟</span></div></div>
          <div class="mt-2 flex flex-wrap items-center gap-2">{entry.categories[0] && <a href={termUrl('categories', entry.categories[0])} class="pointer-events-auto relative flex items-center gap-1 rounded-md border border-primary/20 bg-primary/10 px-2 py-1 text-xs font-medium text-primary"><Icon name="folder" size={12} />{entry.categories[0]}</a>}{entry.tags.slice(0, 3).map(tag => <a href={termUrl('tags', tag)} class="pointer-events-auto relative rounded-md border border-muted/30 bg-muted/50 px-2 py-1 text-xs hover:bg-primary/10 hover:text-primary">{tag}</a>)}</div>
        </div>
      </div>
    </div>}
  </div>
</article>
