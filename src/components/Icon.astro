---
interface Props { name: string; size?: number; class?: string; }
const { name, size = 16, class: className = '' } = Astro.props;
const icons = import.meta.glob('../assets/icons/*.svg', { query: '?raw', import: 'default', eager: true });
const svg = String(icons[`../assets/icons/${name}.svg`] || icons['../assets/icons/file-text.svg']);
---
<span class:list={['site-icon', className]} style={`width:${size}px;height:${size}px`} aria-hidden="true" set:html={svg} />
