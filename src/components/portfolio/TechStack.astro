---
import Badge from './Badge.astro';
import { resume } from '../../data/portfolio';
import { toolLinks } from '../../data/tool-links';
---
<ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 print:grid-cols-1 print:gap-y-3">
  {resume.skills.map((group, index) => <li class="resume-skill min-w-0 rounded-xl border border-border bg-card p-4 print:break-inside-avoid print:border-0 print:bg-transparent print:p-0">
    <div class="print:hidden"><h3 class="mb-3 text-sm leading-6 font-semibold text-foreground">{group.title}</h3><div class="min-w-0 flex flex-wrap gap-2">{group.items.map(label => <Badge label={label} href={toolLinks[label]} />)}</div></div>
    <p class="hidden text-sm leading-7 text-muted-foreground print:block">{group.title}（{group.items.join(' / ')}）{index < resume.skills.length - 1 ? '；' : ''}</p>
  </li>)}
</ul>
