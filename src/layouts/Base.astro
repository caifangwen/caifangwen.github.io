---
import '../styles/global.css';
import { site, withBase, base } from '../lib/site';
import Icon from '../components/Icon.astro';
interface Props { title?: string; description?: string; image?: string; article?: boolean; date?: Date; noindex?: boolean; printContentOnly?: boolean; }
const { title, description = site.description, image = '/images/og-default.avif', article = false, date, noindex = false, printContentOnly = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [['/', '首页', 'home'], ['/posts/', '文章', 'posts'], ['/shares/', '分享', 'link'], ['/discussions/', '讨论', 'message-circle'], ['/projects/', '项目', 'projects'], ['/categories/', '分类', 'categories'], ['/archives/', '归档', 'archive']];
const themes = ['default', 'claude', 'bumblebee', 'emerald', 'nord', 'sunset', 'abyss', 'dracula', 'amethyst', 'slate', 'twitter'];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/frida-home.png')} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={withBase('/index.xml')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase(image), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    {date && <meta property="article:published_time" content={date.toISOString()} />}
    <script is:inline>
      try {
        const legacyTheme = localStorage.getItem('theme');
        const mode = localStorage.getItem('mode') || (['light', 'dark', 'system'].includes(legacyTheme) ? legacyTheme : 'system');
        document.documentElement.classList.toggle('dark', mode === 'dark' || (mode === 'system' && matchMedia('(prefers-color-scheme: dark)').matches));
        document.documentElement.dataset.theme = localStorage.getItem('colorScheme') || (legacyTheme && !['light', 'dark', 'system'].includes(legacyTheme) ? legacyTheme : 'default');
      } catch {}
    </script>
  </head>
  <body class="min-h-screen antialiased" data-base={base}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-card focus:p-3">跳转到正文</a>
    {article && <div id="reading-progress" class="fixed top-0 left-0 z-50 h-0.5 bg-primary" style="width:0" aria-hidden="true"></div>}
    <header class:list={['site-header sticky top-0 z-50 mx-auto max-w-4xl min-[770px]:max-w-[920px] px-4 py-3 max-[769px]:px-[0.9rem]', printContentOnly && 'print:hidden']}>
      <div class="rounded-xl border border-border bg-card/80 px-3 py-2 shadow-sm backdrop-blur-sm md:px-4 md:py-2">
        <div class="flex min-w-0 items-center justify-between">
          <a href={withBase('/')} class="hidden h-9 w-9 shrink-0 overflow-hidden rounded-lg md:flex" aria-label="Frida Home 首页"><img src={withBase('/frida-home.png')} alt="" width="36" height="36" class="h-full w-full object-cover" /></a>
          <button id="menu-toggle" class="header-control md:hidden" aria-label="菜单" aria-expanded="false" aria-controls="mobile-nav"><Icon name="menu" size={20} /></button>
          <nav aria-label="主导航" class="mx-4 hidden min-w-0 flex-1 flex-wrap items-center justify-center gap-1 md:mx-4 md:flex">
            {nav.map(([href, label, icon]) => <a href={withBase(href)} aria-current={Astro.url.pathname === withBase(href) ? 'page' : undefined} class:list={['flex items-center gap-1.5 rounded-md px-2.5 py-1.5 text-sm font-medium hover:bg-primary/10 hover:text-primary', Astro.url.pathname === withBase(href) ? 'bg-accent text-accent-foreground' : 'text-muted-foreground']}><Icon name={icon} />{label}</a>)}
          </nav>
          <div class="flex shrink-0 items-center gap-2">
            <button id="search-open" class="header-control" aria-label="搜索文章" title="搜索文章 (/)"><Icon name="search" size={20} /></button>
            <div class="relative"><button id="theme-toggle" class="header-control" aria-label="配色主题" aria-expanded="false" aria-controls="theme-menu"><Icon name="palette" size={20} /></button><div id="theme-menu" class="theme-menu hidden" aria-label="主题设置">{themes.map(theme => <button data-theme-choice={theme} aria-pressed="false">{theme === 'default' ? 'Default' : theme.charAt(0).toUpperCase() + theme.slice(1)}</button>)}<div class="my-1 border-t border-border"></div><button id="mode-toggle" aria-label="切换深色模式"><Icon name="sun" /> <span class="ml-2">切换明暗模式</span></button></div></div>
          </div>
        </div>
        <nav id="mobile-nav" aria-label="移动导航" class="mt-3 hidden flex-wrap gap-1 border-t border-border pt-3 md:hidden">{nav.map(([href, label, icon]) => <a class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm hover:bg-muted" href={withBase(href)}><Icon name={icon} />{label}</a>)}</nav>
      </div>
    </header>
    <main id="main" class:list={['mx-auto max-w-4xl px-4 py-6', printContentOnly && 'print:max-w-none print:p-0']}><slot /></main>
    <footer class:list={['mx-auto max-w-4xl px-4 py-5 md:py-8 max-[769px]:px-[0.9rem]', printContentOnly && 'print:hidden']}><div class="md:py-6">
      <div class="mb-3 border-t border-border md:mb-6"></div><div class="flex flex-col items-center justify-between gap-3 md:flex-row md:gap-4"><div class="text-center text-xs text-muted-foreground md:text-left"><p class="mb-1">© {new Date().getFullYear()} {site.title}. 保留所有权利.</p><p>Powered by <a href="https://astro.build" class="font-medium text-primary">Astro</a></p></div><div class="flex items-center gap-2"><a href={site.github} aria-label="GitHub" class="p-1 text-muted-foreground hover:text-primary"><Icon name="github" size={20} /></a><a href={site.email} aria-label="邮箱" class="p-1 text-muted-foreground hover:text-primary"><Icon name="email" size={20} /></a></div></div></div>
    </footer>
    <div id="dock" class:list={['pointer-events-none fixed bottom-4 left-1/2 z-50 -translate-x-1/2 translate-y-24 opacity-0 transition-all duration-300', printContentOnly && 'print:hidden']} role="toolbar" aria-label="快捷操作工具栏"><nav class="flex items-center gap-2 rounded-2xl border border-border bg-card/80 px-4 py-3 shadow-lg backdrop-blur-sm"><button id="dock-search" aria-label="搜索" class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-muted-foreground hover:bg-primary/10"><Icon name="search" /><span class="hidden md:inline">搜索</span></button>{article && <a href="#article-toc" class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-muted-foreground xl:hidden" aria-label="查看目录"><Icon name="list" /><span class="hidden sm:inline">目录</span></a>}<a href="#main" aria-label="返回顶部" class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-muted-foreground hover:bg-primary/10"><Icon name="arrow-up" /><span class="hidden sm:inline">顶部</span></a></nav></div>
    <dialog id="search-dialog" class:list={['fixed m-auto max-h-[80vh] w-[calc(100%-2rem)] max-w-xl rounded-2xl border border-border p-0 shadow-xl', printContentOnly && 'print:hidden']} aria-labelledby="search-title">
      <div class="flex items-center justify-between border-b border-border px-5 py-4"><h2 id="search-title" class="font-semibold">搜索站内内容</h2><button id="search-close" class="rounded px-2 py-1 hover:bg-muted" aria-label="关闭搜索">✕</button></div>
      <div class="p-5"><label for="search-input" class="sr-only">关键词</label><input id="search-input" type="search" placeholder="输入标题、标签或正文关键词…" autocomplete="off" class="w-full rounded-lg border border-border bg-background px-4 py-3 outline-none" /><p id="search-status" class="mt-3 text-sm text-muted-foreground" role="status">输入关键词开始搜索</p><ul id="search-results" class="mt-3 max-h-[45vh] overflow-y-auto"></ul></div>
    </dialog>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
