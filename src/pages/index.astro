---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import { getEntries } from '../lib/content';
import { site, withBase, type Section } from '../lib/site';
const groups: { section: Section; title: string; count: number }[] = [
  { section: 'projects', title: '特色项目', count: 3 },
  { section: 'posts', title: '最近文章', count: 5 },
  { section: 'shares', title: '分享', count: 6 },
  { section: 'discussions', title: '讨论', count: 6 },
];
---
<Base>
  <section class="author-section mb-12">
    <div class="rounded-xl border border-border bg-card p-8 shadow-sm"><div class="flex flex-col items-center gap-6 text-center md:flex-row md:items-start md:text-left">
      <img src={withBase('/images/avatar.svg')} alt={site.author} width="96" height="96" class="h-24 w-24 shrink-0 rounded-full border-4 border-primary/20 object-cover shadow-lg" />
      <div class="min-w-0 flex-1"><h1 class="mb-2 text-3xl font-bold text-foreground">{site.author}</h1><p class="mb-3 text-lg text-muted-foreground">{site.tagline}</p><p class="mb-4 leading-relaxed text-foreground">{site.bio}</p><div class="flex flex-wrap justify-center gap-3 md:justify-start"><a href={withBase('/portfolio/')} class="inline-flex items-center gap-2 rounded-lg bg-muted px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-primary/10 hover:text-primary"><Icon name="user" />Portfolio</a><a href={site.github} class="inline-flex items-center gap-2 rounded-lg bg-muted px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-primary/10 hover:text-primary"><Icon name="github" />GitHub</a><a href={site.email} class="inline-flex items-center gap-2 rounded-lg bg-muted px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-primary/10 hover:text-primary"><Icon name="email" />邮箱</a></div></div>
    </div></div>
  </section>
  <div class="mb-6 rounded-xl border border-primary/30 bg-primary/10 p-6 shadow-sm"><div class="flex items-start gap-4"><span class="mt-0.5 shrink-0 text-2xl" aria-hidden="true">📢</span><div class="flex-1 space-y-2"><p class="leading-relaxed text-foreground/80">最近在vibe coding</p><p class="mt-3 text-xs text-muted-foreground/60">2025 年 12 月 31 日</p></div></div></div>
  {groups.map(({ section, title, count }) => <section class:list={[section === 'posts' ? 'post-list home-list mb-8' : section === 'projects' ? 'mb-6' : section === 'shares' ? 'featured-shares my-8' : 'featured-discussions']}><div class:list={['flex items-center justify-between', section === 'projects' ? 'mb-6' : 'mb-4 md:mb-6']}><h2 class="text-2xl font-bold text-foreground">{title}</h2>{section !== 'projects' && <a href={withBase(`/${section}/`)} class="flex items-center gap-1 text-sm font-medium text-primary hover:text-primary/80">查看全部<Icon name="arrow-right" size={12} /></a>}</div><div class={section === 'projects' ? 'grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3' : 'space-y-4'}>{getEntries(section).filter(entry => section !== 'projects' || entry.featured).slice(0, count).map(entry => <Card entry={entry} home={section === 'posts'} />)}</div></section>)}
</Base>
