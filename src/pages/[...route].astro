---
import Base from '../layouts/Base.astro';
import RelatedContent from '../components/RelatedContent.astro';
import ContentList from '../components/ContentList.astro';
import Icon from '../components/Icon.astro';
import TaxonomyPage from '../components/Taxonomy.astro';
import { entries, getEntries, assetPath } from '../lib/content';
import { renderMarkdown } from '../lib/markdown';
import { sections, taxonomies, withBase, termUrl, formatLongDate as formatDate, site } from '../lib/site';
import { contentRoutes, type ContentPage } from '../lib/routes';
interface Props { page: ContentPage; }
export function getStaticPaths() {
  return contentRoutes.map(({ url, page }) => ({ params: { route: url.replace(/^\/|\/$/g, '') }, props: { page } }));
}
const { page } = Astro.props;
if (page.kind === 'redirect') return Astro.redirect(withBase(page.target));
const entry = page.kind === 'article' ? page.entry : undefined;
const rendered = entry ? renderMarkdown(entry) : undefined;
const title = page.kind === 'terms' ? taxonomies[page.type] : page.kind === 'list' ? `${page.title}${page.current > 1 ? ` · 第 ${page.current} 页` : ''}` : page.entry.title;
const siblings = entry ? getEntries(entry.section) : [];
const currentIndex = entry ? siblings.indexOf(entries.find(item => item.url === entry.url)!) : -1;
const related = entry ? entries.filter(item => item.url !== entry.url && item.tags.some(tag => entry.tags.includes(tag))).slice(0, 3) : [];
const seriesEntries = entry ? entries.filter(item => item.url !== entry.url && item.series.some(series => entry.series.includes(series))) : [];
---
<Base title={title} description={entry?.description || (page.kind === 'list' ? page.description : undefined)} article={!!entry} date={entry?.date} image={entry?.cover ? assetPath(entry, entry.cover) : undefined}>
  {page.kind === 'terms' ? <>
    <TaxonomyPage type={page.type} />
  </> : page.kind === 'list' ? <>
    <ContentList title={title} entries={page.entries} description={page.description} root={page.root} current={page.current} total={page.total} />
  </> : entry && rendered && <>
    <nav aria-label="面包屑" class="mb-6 flex flex-wrap gap-2 text-sm text-muted-foreground"><a href={withBase('/')}>首页</a><span>/</span><a href={withBase(entry.section === 'posts' ? '/articles/' : `/${entry.section}/`)}>{sections[entry.section]}</a></nav>
    <article class="article-page">
      {entry.cover && <img src={withBase(assetPath(entry, entry.cover))} alt={entry.title} class="mb-8 h-64 w-full rounded-2xl object-cover md:h-80" />}
      <header class="mb-8"><div class="post-meta"><div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted-foreground"><span class="flex items-center gap-1.5"><Icon name="calendar" /><time datetime={entry.date.toISOString()}>{formatDate(entry.date)}</time></span><span class="flex items-center gap-1.5"><Icon name="clock" />{entry.minutes} 分钟</span><span class="flex items-center gap-1.5"><Icon name="text" />{entry.body.replace(/\s/g, '').length} 字</span></div><h1 class="mt-3 mb-3 text-2xl leading-tight font-bold text-foreground md:mt-4 md:mb-6 md:text-4xl">{entry.title}</h1>{entry.description && <p class="mb-4 text-base leading-relaxed text-muted-foreground md:mb-6">{entry.description}</p>}<div class="flex flex-wrap items-center gap-2">{entry.categories.map(category => <a class="rounded-full bg-primary/10 px-3 py-1 text-sm font-medium text-primary hover:bg-primary/20" href={termUrl('categories', category)}>{category}</a>)}{entry.tags.map(tag => <a class="rounded bg-muted/50 px-2 py-1 text-sm text-muted-foreground hover:bg-primary/10 hover:text-primary" href={termUrl('tags', tag)}>#{tag}</a>)}</div></div>
      {(entry.github || entry.website || entry.linkUrl) && <div class="mt-5 flex flex-wrap gap-3">{[[entry.github, 'GitHub ↗'], [entry.website, '项目网站 ↗'], [entry.linkUrl, '访问链接 ↗']].filter(([url]) => url).map(([url, label]) => <a href={url} class="rounded-lg border border-border px-4 py-2 text-sm hover:bg-muted" rel="noopener noreferrer">{label}</a>)}</div>}
      {entry.tech.length > 0 && <p class="mt-4 text-xs text-muted-foreground">{entry.tech.join(' · ')}</p>}</header>
      {rendered.headings.length > 0 && <><details id="article-toc" class="mb-8 rounded-xl border border-border p-4 xl:hidden"><summary class="font-medium">文章目录</summary><nav aria-label="文章目录" class="mt-3 grid gap-2 text-sm text-muted-foreground">{rendered.headings.map(heading => <a href={`#${heading.slug}`} style={`padding-left:${(heading.depth - 2) * 12}px`} class="hover:text-primary">{heading.text}</a>)}</nav></details><aside class="article-toc hidden xl:block" aria-label="文章目录侧栏"><h2 class="mb-4 flex items-center gap-2 text-sm font-semibold"><Icon name="list" />目录</h2><nav aria-label="桌面文章目录" class="text-sm text-muted-foreground">{rendered.headings.map(heading => <a href={`#${heading.slug}`} style={`padding-left:${(heading.depth - 2) * 12 + 8}px`}>{heading.text}</a>)}</nav></aside></>}
      <div class="prose prose-neutral mb-12 max-w-none" set:html={rendered.html} />
      {seriesEntries.length > 0 && <aside class="mt-8 rounded-xl bg-muted p-5"><h2 class="mb-3 font-semibold">系列文章 · {entry.series.join('、')}</h2><ul class="space-y-2 text-sm">{seriesEntries.map(item => <li><a href={withBase(item.url)}>{item.title}</a></li>)}</ul></aside>}
      <aside class="post-license mb-8 rounded-xl border border-border bg-muted/30 p-6 text-sm leading-7 text-muted-foreground"><h2 class="mb-2 flex items-center gap-2 font-semibold text-foreground"><Icon name="license" />版权声明</h2>本文由 {site.author} 发布，采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" class="underline">CC BY-NC-SA 4.0</a> 协议。转载请注明来源。</aside>
    </article>
    <nav aria-label="相邻文章" class="post-navigation my-6 grid gap-4 sm:grid-cols-2">{[siblings[currentIndex - 1], siblings[currentIndex + 1]].map((item, i) => item && <a href={withBase(item.url)} class:list={['rounded-xl border border-border bg-card p-5', i === 1 && 'text-right sm:col-start-2']}><span class:list={['mb-2 flex items-center gap-1.5 text-xs text-muted-foreground', i === 1 && 'justify-end']}>{i === 0 ? <><Icon name="chevron-left" size={14} />上一篇</> : <>下一篇<Icon name="chevron-right" size={14} /></>}</span><span class="text-sm font-medium">{item.title}</span></a>)}</nav>
    {related.length > 0 && <section class="related-posts mt-9"><h2 class="mb-3 text-xl font-bold">相关文章</h2><RelatedContent entries={related} /></section>}
    <section class="article-comments mt-10" aria-label="评论"><h2 class="mb-5 text-xl font-bold">评论</h2><script is:inline src="https://giscus.app/client.js" data-repo="caifangwen/blog-comments" data-repo-id="R_kgDORDZb2g" data-category="Announcements" data-category-id="DIC_kwDORDZb2s4C1i_z" data-mapping="pathname" data-strict="0" data-reactions-enabled="0" data-emit-metadata="0" data-input-position="bottom" data-theme="preferred_color_scheme" data-lang="zh-CN" crossorigin="anonymous" async></script></section>
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'BlogPosting', headline: entry.title, description: entry.description, datePublished: entry.date.toISOString(), dateModified: entry.updated.toISOString(), author: { '@type': 'Person', name: site.author }, mainEntityOfPage: new URL(withBase(entry.url), Astro.site).href }).replaceAll('<', '\\u003c')} />
  </>}
</Base>
