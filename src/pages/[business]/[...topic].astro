---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import BusinessCategories from '../../components/BusinessCategories.astro';
import ContentList from '../../components/ContentList.astro';
import Icon from '../../components/Icon.astro';
import { businessNavigation, type BusinessTopic } from '../../data/business-navigation';
import { businessTopics, getTopicEntries } from '../../lib/business';
import { withBase } from '../../lib/site';
interface Props { topic: BusinessTopic; }
export function getStaticPaths() {
  return businessTopics.map(topic => {
    const [business, child] = topic.path.split('/').filter(Boolean);
    return { params: { business, topic: child }, props: { topic } };
  });
}
const { topic } = Astro.props;
const parent = businessNavigation.find(root => topic.path.startsWith(root.path))!;
const isRoot = topic === parent || topic.path === parent.path;
const content = getTopicEntries(topic);
---
<Base title={topic.title} description={topic.description}>
  <aside class="business-sidebar hidden xl:block"><BusinessCategories topic={parent} /></aside>
  {isRoot ? <>
    <nav aria-label="面包屑" class="mb-6 flex items-center gap-2 text-sm text-muted-foreground"><a href={withBase('/')}>首页</a><Icon name="chevron-right" size={12} /><span>{topic.title}</span></nav>
    <header class="mb-8"><div class="mb-3 flex items-baseline justify-between gap-4"><h1 class="text-3xl font-bold">{topic.title}</h1><span class="shrink-0 text-sm text-muted-foreground">{content.length} 篇</span></div><p class="leading-7 text-muted-foreground">{topic.description}</p></header>
    <details class="mb-6 border-y border-border py-3 xl:hidden"><summary class="cursor-pointer text-sm font-medium">子类别</summary><div class="pt-4"><BusinessCategories topic={topic} /></div></details>
    <div class="post-list space-y-4">{content.map(entry => <Card entry={entry} />)}</div>{!content.length && <p class="py-12 text-center text-muted-foreground">暂无文章</p>}
  </> : <ContentList title={topic.title} description={`共 ${content.length} 篇内容`} entries={content} parent={parent}>
    <details class="mb-6 border-y border-border py-3 xl:hidden"><summary class="cursor-pointer text-sm font-medium">子类别</summary><div class="pt-4"><BusinessCategories topic={parent} /></div></details>
  </ContentList>}
</Base>
