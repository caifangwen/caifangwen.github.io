---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/site';
---
<Base title="页面未找到" noindex><div class="py-24 text-center"><p class="text-7xl font-bold text-muted-foreground">404</p><h1 class="mt-6 text-2xl font-bold">这里还没有内容</h1><p class="mt-3 text-muted-foreground">页面可能已移动，也可以使用搜索寻找文章。</p><a href={withBase('/')} class="mt-8 inline-block rounded-xl bg-primary px-6 py-3 text-primary-foreground">返回首页</a></div></Base>
