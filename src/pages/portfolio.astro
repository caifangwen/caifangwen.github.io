---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/portfolio/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceTimeline from '../components/portfolio/ExperienceTimeline.astro';
import TechStack from '../components/portfolio/TechStack.astro';
import EducationCard from '../components/portfolio/EducationCard.astro';
import { resume } from '../data/portfolio';
import { withBase } from '../lib/site';
import { getEntries } from '../lib/content';
const resumeUrl = withBase('/resume/cai-fangwen-resume.docx');
const projects = ['business-data-dashboard', 'workflow-deployment'].map(slug => getEntries('projects').find(entry => entry.slug === slug)!);
---
<Base title="蔡方闻 · Portfolio" description={resume.role} printContentOnly>
  <div class="portfolio space-y-9 text-foreground print:space-y-5">
    <nav aria-label="面包屑" class="flex items-center gap-2 text-sm text-muted-foreground print:hidden">
      <a href={withBase('/')} class="inline-flex items-center gap-1.5 hover:text-primary"><Icon name="home" />首页</a>
      <Icon name="chevron-right" size={12} /><span>Portfolio</span>
    </nav>
    <section aria-labelledby="resume-name" class="resume-profile border-0 bg-transparent px-0">
      <div class="flex flex-col gap-5 px-0 py-2 print:p-0">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div><h1 id="resume-name" class="mb-2 text-3xl font-bold md:text-4xl">{resume.name}</h1></div>
        </div>
        <p class="text-base leading-7 text-muted-foreground md:text-lg">{resume.role}</p>
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div class="resume-contact flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted-foreground"><a href={'mailto:' + resume.email} class="inline-flex items-center gap-2 hover:text-primary"><Icon name="email" />{resume.email}</a><a href={'tel:' + resume.phone} class="inline-flex items-center gap-2 hover:text-primary"><Icon name="phone" />{resume.phone}</a></div>
          <div class="resume-actions ml-auto flex flex-wrap justify-end gap-2 print:hidden"><button id="resume-print" type="button" class="inline-flex items-center gap-2 rounded-lg border border-border px-3 py-2 text-xs font-medium hover:bg-muted"><Icon name="file-text" size={14} />打印 / 保存 PDF</button><a href={resumeUrl} download="蔡方闻简历.docx" class="inline-flex items-center gap-2 rounded-lg bg-primary px-3 py-2 text-xs font-medium text-primary-foreground hover:bg-primary/90"><Icon name="file-text" size={14} />下载简历 · DOCX</a></div>
        </div>
      </div>
    </section>
    <section id="skills" class="scroll-mt-32">
      <SectionHeading title="专业技能" icon="code" />
      <TechStack />
    </section>
    <section id="experience" class="scroll-mt-32">
      <SectionHeading title="工作经验" icon="projects" /><ExperienceTimeline />
    </section>
    <section id="projects" class="scroll-mt-32">
      <SectionHeading title="项目亮点" icon="layers" />
      <div class="grid gap-4 sm:grid-cols-2 print:grid-cols-1">{projects.map(entry => <article class="resume-project"><ProjectCard title={entry.title} description={entry.description} href={withBase(entry.url)} expanded /></article>)}</div>
    </section>
    <section id="education" class="scroll-mt-32 print:break-inside-avoid">
      <SectionHeading title="教育经历" icon="library" />
      <EducationCard />
    </section>
  </div>
  <script>
    document.querySelector('#resume-print')?.addEventListener('click', () => window.print());
  </script>
</Base>
